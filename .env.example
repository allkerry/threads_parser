# Copy to .env and fill in real values. Never commit .env itself.

# Overrides config.yaml:store_endpoint if set.
STORE_ENDPOINT=http://127.0.0.1:9000/store_items

LOG_LEVEL=INFO

# Proxy credentials, referenced by name from accounts.yaml (proxy.username_env/password_env).
PROXY_ACCOUNT_1_USER=
PROXY_ACCOUNT_1_PASS=
PROXY_ACCOUNT_2_USER=
PROXY_ACCOUNT_2_PASS=
